{
  "expo": {
    "name": "SnapStudy AI",
    "slug": "snapstudy-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SnapStudy AI needs access to your camera to snap photos of textbook pages and notes."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SnapStudy AI needs access to your camera to snap photos of textbook pages and notes."
        }
      ]
    ]
  }
}
